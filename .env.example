PORT=4500
URI=mongodb+srv://<user>:<password>@<cluster>/<database>

JWT_SECRET=<random-long-secret>
ADMIN_JWT_SECRET=<random-long-secret>
PAYSTACK_SECRET_KEY=<paystack-secret-key>

# Frontend origin used to build payment callback, password reset AND email
# verification links (<FRONTEND_URL>/verify-email/<token>).
# In production this MUST be the public production frontend origin
# (e.g. https://your-frontend.example.com) — never localhost, or users
# receive links that don't work. localhost is for local development only.
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Brevo HTTP API — the only email provider. Works on Render's free tier
# (outbound SMTP is blocked there). Verify the sender email under
# "Senders & IPs" in Brevo, then paste the API key below. That's all that's
# required; BREVO_FROM is optional and defaults to the verified sender.
BREVO_API_KEY=<brevo-api-key>
BREVO_FROM=EU Hardwarestore <datasub09@gmail.com>
