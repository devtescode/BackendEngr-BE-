PORT=4500
URI=mongodb+srv://<user>:<password>@<cluster>/<database>

JWT_SECRET=<random-long-secret>
ADMIN_JWT_SECRET=<random-long-secret>
PAYSTACK_SECRET_KEY=<paystack-secret-key>

# Frontend origin used to build payment callback, password reset AND email
# verification links (<FRONTEND_URL>/verify-email/<token>).
# In production this MUST be the public production frontend origin
# (e.g. https://your-frontend.example.com) — never localhost, or users
# receive links that don't work. localhost is for local development only.
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# SendByte (password reset + email verification emails) — sk_test_ keys are
# sandboxed, sk_live_ keys deliver. Production needs a live key.
SENDBYTE_API_KEY=<sendbyte-api-key>
# Sender address MUST be on a domain verified in SendByte, otherwise sends fail
# (signup then returns VERIFICATION_EMAIL_FAILED).
SENDBYTE_FROM=EU Hardwarestore <no-reply@yourdomain.com>

# Who sends emails: gmail or sendbyte (default)
EMAIL_PROVIDER=gmail
# Gmail sender — a Google App Password (requires 2-Step Verification on the
# account), not the account password. Emails are sent from GMAIL_USER.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=<16-character-app-password>
