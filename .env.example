PORT=4500
URI=mongodb+srv://<user>:<password>@<cluster>/<database>

JWT_SECRET=<random-long-secret>
ADMIN_JWT_SECRET=<random-long-secret>
PAYSTACK_SECRET_KEY=<paystack-secret-key>

# Frontend origin used to build payment callback and password reset links
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# SendByte (password reset emails) — sk_test_ keys are sandboxed, sk_live_ keys deliver
SENDBYTE_API_KEY=<sendbyte-api-key>
# Sender on a domain verified in SendByte
SENDBYTE_FROM=EU Hardwarestore <no-reply@yourdomain.com>

# Who sends emails: gmail or sendbyte (default)
EMAIL_PROVIDER=gmail
# Gmail sender — a Google App Password, not the account password
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=<16-character-app-password>
